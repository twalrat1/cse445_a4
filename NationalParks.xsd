<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="https://twalrat1.github.io/cse445_a4/"
    xmlns="https://twalrat1.github.io/cse445_a4/NationalParks.xsd"
    elementFormDefault="qualified" attributeFormDefault="unqualified">
    <!-- Define root NationalParks Element -->
    <xs:element name="NationalParks">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="NationalPark" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <!-- Define NationalPark child of NationalParks -->
    <xs:element name="NationalPark">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Name" type="xs:string"/>
                <xs:element name="Phone" type="xs:string" minOccurs="1" maxOccurs="unbounded"/>
                <xs:element name="Address" minOccurs="1" maxOccurs="1"/>
            </xs:sequence>
            <xs:attribute name="Rating" type="xs:decimal" use="optional"/>
        </xs:complexType>
    </xs:element>
    <!-- Define Address a child of NationalPark -->
    <xs:element name="Address">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Number" type="xs:integer"/>
                <xs:element name="Street" type="xs:string"/>
                <xs:element name="City" type="xs:string"/>
                <xs:element name="State" type="xs:string"/>
                <xs:element name="Zip" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="NearestAirport" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
</xs:schema>