<?xml version="1.0" encoding="UTF-8"?>

<schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="https://twalrat1.github.io/cse445_a4/"
    xmlns="https://twalrat1.github.io/cse445_a4/NationalParks.xsd"
    elementFormDefault="qualified" attributeFormDefault="unqualified">
    <!-- Define root NationalParks Element -->
    <element name="NationalParks">
        <complexType>
            <sequence>
                <element name="NationalPark" minOccurs="1" maxOccurs="unbounded"/>
            </sequence>
        </complexType>
    </element>
    <!-- Define NationalPark child of NationalParks -->
    <element name="NationalPark">
        <complexType>
            <sequence>
                <element name="Name" type="xs:string"/>
                <element name="Phone" type="xs:string" minOccurs="1" maxOccurs="unbounded"/>
                <element name="Address" minOccurs="1" maxOccurs="1"/>
            </sequence>
            <attribute name="Rating" type="xs:decimal" use="optional"/>
        </complexType>
    </element>
    <!-- Define Address a child of NationalPark -->
    <element name="Address">
        <complexType>
            <sequence>
                <element name="Number" type="xs:integer"/>
                <element name="Street" type="xs:string"/>
                <element name="City" type="xs:string"/>
                <element name="State" type="xs:string"/>
                <element name="Zip" type="xs:string"/>
            </sequence>
            <attribute name="NearestAirport" type="xs:string" use="required"/>
        </complexType>
    </element>
</schema>